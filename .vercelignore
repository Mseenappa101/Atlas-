# Vercel hosts only the website. These run elsewhere (Railway) or locally,
# and a top-level api/ folder would otherwise be treated as Vercel Functions.
api/
worker/
scripts/*
# The build runs these two: per-page titles/sitemap/robots, then the SSR prerender of the marketing
# routes. They MUST be kept in the Vercel upload (scripts/* excludes everything else in scripts/).
!scripts/prerender-meta.mjs
!scripts/prerender.mjs
supabase/
